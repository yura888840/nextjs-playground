# Local development credentials only. Use your provider's URL in production.
DATABASE_URL=postgresql://playground:playground@localhost:5432/playground
# Tests require a separate, initially empty database whose name ends in _test.
TEST_DATABASE_URL=postgresql://playground:playground@localhost:5432/playground_test

# Set to the exact public origin in Vercel, without a trailing slash.
# APP_ORIGIN=https://your-project.vercel.app

# Optional: random 32+ character secret shared with GitHub repository webhooks.
# GITHUB_WEBHOOK_SECRET=

# Email jobs default to preview: no provider call, no email sent.
EMAIL_MODE=preview
# Optional worker endpoint secret (32+ random characters); not needed by the local CLI.
# EMAIL_WORKER_SECRET=
# Required only after explicitly setting EMAIL_MODE=send:
# RESEND_API_KEY=
# EMAIL_FROM=Your App <tasks@your-verified-domain.example>
